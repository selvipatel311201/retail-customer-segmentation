{
  "name": "Retail Segmentation — validated",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "good": "#008300",
  "neutral": "#6b7280",
  "bad": "#e34948",
  "maximum": "#1d4ed8",
  "center": "#9aa0a6",
  "minimum": "#dbeafe",
  "null": "#f3f4f6",
  "background": "#ffffff",
  "secondaryBackground": "#f6f7f8",
  "tableAccent": "#2a78d6",
  "foreground": "#15171a",
  "textClasses": {
    "title":    { "fontSize": 15, "fontFace": "Segoe UI Semibold", "color": "#15171a" },
    "header":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#6b7280" },
    "label":    { "fontSize": 11, "fontFace": "Segoe UI",          "color": "#15171a" },
    "callout":  { "fontSize": 34, "fontFace": "Segoe UI",          "color": "#15171a" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":   [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border":       [{ "show": true, "color": { "solid": { "color": "#e5e7eb" } }, "radius": 8 }],
        "visualHeader": [{ "show": false }],
        "title": [{
          "show": true, "fontColor": { "solid": { "color": "#15171a" } },
          "fontSize": 13, "alignment": "left", "background": { "solid": { "color": "#ffffff" } }
        }],
        "categoryAxis": [{
          "showAxisTitle": false, "gridlineShow": false,
          "labelColor": { "solid": { "color": "#6b7280" } }, "fontSize": 10
        }],
        "valueAxis": [{
          "showAxisTitle": false,
          "gridlineColor": { "solid": { "color": "#eceef0" } },
          "gridlineThickness": 1, "gridlineStyle": "solid",
          "labelColor": { "solid": { "color": "#6b7280" } }, "fontSize": 10
        }],
        "legend": [{
          "show": true, "position": "Top", "showTitle": false,
          "labelColor": { "solid": { "color": "#6b7280" } }, "fontSize": 10
        }],
        "labels": [{
          "show": false,
          "color": { "solid": { "color": "#15171a" } }, "fontSize": 10
        }]
      }
    },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#15171a" } }, "fontSize": 32 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#6b7280" } }, "fontSize": 11 }],
        "border":         [{ "show": true, "color": { "solid": { "color": "#e5e7eb" } }, "radius": 8 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontalColor": { "solid": { "color": "#eceef0" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#6b7280" } }, "backColor": { "solid": { "color": "#ffffff" } }, "fontSize": 10 }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontalColor": { "solid": { "color": "#eceef0" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#6b7280" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": false }],
        "items":  [{ "fontColor": { "solid": { "color": "#15171a" } }, "fontSize": 11 }]
      }
    }
  }
}
